# Standalone local dev (running `npm run start:dev` directly, NOT via
# docker-compose). If you're using the root docker-compose.yml stack instead,
# use the root .env.example and run everything through `docker compose up`.
#
# This assumes a Postgres reachable at localhost:5432 — either a local
# install, or `docker compose up -d postgres` from the repo root exposed on
# POSTGRES_HOST_PORT (update the port below to match if so).

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/theextraction?schema=public&connection_limit=20&pool_timeout=20"

# JWT — generate your own, e.g. `openssl rand -hex 32`. Never use this value for real.
JWT_SECRET="change-me-to-a-long-random-value"
JWT_EXPIRES_IN="24h"

# SMTP Configuration (for OTP emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="The Extraction <noreply@example.com>"

# Frontend URL (also used for the CORS allow-list)
FRONTEND_URL="http://localhost:43117"

# Event Configuration
EVENT_DATE="February 1, 2026"
EVENT_NAME="The Extraction"

# Redis (for rate limiting and real-time features)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Server
PORT=43118
NODE_ENV="development"
