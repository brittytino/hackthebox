# ============================================
# Email (SMTP) Configuration
# ============================================
# Line 1: Your Gmail address
SMTP_USER=your-email@gmail.com

# Line 2: A Gmail App Password (Google Account > Security > App Passwords)
# Never a real account password, and never commit a real value here.
SMTP_PASS=xxxx xxxx xxxx xxxx

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=theextraction

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-to-a-long-random-value

# ============================================
# Backend Configuration
# ============================================
BACKEND_PORT=43118
NODE_ENV=production

# Database URL for Prisma (do NOT edit - uses above values)
# connection_limit/pool_timeout are set for ~50 concurrent participants
# hitting the API at once; raise connection_limit further for larger events.
DATABASE_URL=postgresql://postgres:change-me-to-a-long-random-value@postgres:5432/theextraction?schema=public&connection_limit=20&pool_timeout=20

# JWT Secret — generate your own long random value, e.g. `openssl rand -hex 32`.
# Never reuse the example value below in a real deployment.
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=24h

# SMTP Configuration (Gmail - required for email OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=The Extraction <noreply@example.com>

# Frontend URL (used for CORS allow-list — set this to your real deployed origin)
FRONTEND_URL=http://localhost:43117

# Event Information
EVENT_DATE=February 11, 2026
EVENT_NAME=The Extraction

# ============================================
# Frontend Configuration
# ============================================
NEXTJS_PORT=43117
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://backend:43118/api

# ============================================
# pgAdmin Configuration
# ============================================
# Change these — the pgAdmin container ships with default admin@admin.com/admin
# if these are left unset, and it has full read/write access to the database.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-to-a-long-random-value

# Host-exposed service ports (uncommon)
# These are bound to 127.0.0.1 only in docker-compose.yml — do not expose
# Postgres/Redis/pgAdmin to the LAN or internet.
POSTGRES_HOST_PORT=45432
REDIS_HOST_PORT=46379
PGADMIN_HOST_PORT=45050
